# Ex-Files configuration. Copy to .env and fill in the secrets.
# The server reads these from the environment; nothing here is required to run
# the demo (it falls back to dry-run mode).

# --- Africa's Talking Voice (Awkward Silence Timer goat calls) ---
# Caller id the goat calls come from. Defaults to this if unset.
AT_VOICE_NUMBER=+256323200942
# Real outbound calls also need these two (keep them secret; do NOT commit .env):
AT_USERNAME=
AT_API_KEY=
# Optional: an mp3 of a screaming goat to play on the call. Falls back to a
# spoken goat if unset.
GOAT_AUDIO_URL=

# --- Server / demo ---
# Port to listen on (default 3000).
PORT=3000
# Silence threshold in ms before the goat calls (default 86400000 = 24h).
# Lower it for a live demo, e.g. 8000 to fire after 8 seconds.
SILENCE_MS=
